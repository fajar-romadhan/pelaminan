# ============================================================
# .gitignore - Pelaminan Family
# ============================================================

# ---- File konfigurasi lokal & rahasia (JANGAN di-push ke GitHub) ----
config/database.php
config/mail.php


# ---- File upload user (besar, tidak perlu di-repo) ----
# CATATAN: uploads/ dikecualikan agar foto produk tidak memenuhi repo.
# Upload foto produk dilakukan manual via cPanel File Manager.
# uploads/

# ---- Catatan & Dokumentasi Proyek (Lokal Saja) ----
PROJECT_KNOWLEDGE.md
HOSTING_NOTES.md
DOKUMEN_HALAMAN_SISTEM.md
.agents/

# ---- File sementara & scratch ----
scratch/

# ---- File arsip / zip ----
*.zip
*.tar.gz
*.rar

# ---- File log & SSH Keys ----
*.log
id_rsa
id_rsa*
*.pem
*.pub

# ---- OS & Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ---- Dependency managers (tidak ada di proyek ini tapi jaga-jaga) ----
/vendor/
node_modules/

# ---- File environment lokal ----
.env
.env.local

# ---- File tools sementara (migration & diagnostik) ----
fix_db_migration.sql
diag.php
