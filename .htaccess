# ============================================================
# .htaccess - Pelaminan Family
# ============================================================

Options -Indexes

# Lindungi file sensitif dari akses publik
<FilesMatch "\.(sql|md|log|env|json|lock|yml|gitignore)$">
    Require all denied
</FilesMatch>

# Lindungi folder config dari akses langsung
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke folder config
    RewriteRule ^config/ - [F,L]

    # Blokir akses langsung ke folder scratch
    RewriteRule ^scratch/ - [F,L]
</IfModule>

# Kompresi GZIP untuk performa
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# Cache untuk file statis
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Encoding default
AddDefaultCharset UTF-8
